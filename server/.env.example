# Copy this file to .env before starting locally (Node.js 22+).
# Replace YOUR_PASSWORD with the URL-encoded database user password.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/OravelLifestyle?retryWrites=true&w=majority
MONGODB_DB=OravelLifestyle
PORT=5000
PUBLIC_BASE_URL=http://localhost:5000
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
ADMIN_EMAIL=
ADMIN_PASSWORD=
NODE_ENV=development
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OTP_EXPIRY_MINUTES=10
OTP_DEV_RETURN_CODE=false
OTP_INCLUDE_CODE_WHEN_SENT=false
SMS_API_URL=
SMS_API_TOKEN=
WHATSAPP_NUMBER=
AI_ASSISTANT_VISIBLE=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ASSISTANT_MAX_TOKENS=500
